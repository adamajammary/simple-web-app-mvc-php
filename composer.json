{
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "8.3.*",
        "ext-iconv": "*",
        "doctrine/common": "^3",
        "doctrine/doctrine-bundle": "^2",
        "doctrine/doctrine-migrations-bundle": "^3",
        "doctrine/orm": "^3",
        "phpdocumentor/reflection-docblock": "^6",
        "symfony/apache-pack": "^1",
        "symfony/asset": "^7",
        "symfony/console": "^7",
        "symfony/expression-language": "^7",
        "symfony/flex": "^2",
        "symfony/form": "^7",
        "symfony/framework-bundle": "^7",
        "symfony/monolog-bundle": "^4",
        "symfony/process": "^7",
        "symfony/property-access": "^7",
        "symfony/property-info": "^7",
        "symfony/security-bundle": "^7",
        "symfony/serializer": "^7",
        "symfony/twig-bundle": "^7",
        "symfony/validator": "^7",
        "symfony/web-link": "^7",
        "symfony/yaml": "^7"
    },
    "require-dev": {
        "doctrine/cache": "^2",
        "symfony/browser-kit": "^7",
        "symfony/css-selector": "^7",
        "symfony/debug-bundle": "^7",
        "symfony/dotenv": "^7",
        "symfony/maker-bundle": "^1",
        "symfony/phpunit-bridge": "^7",
        "symfony/stopwatch": "^7",
        "symfony/web-profiler-bundle": "^7"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php71": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php56": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install --symlink --relative %PUBLIC_DIR%": "symfony-cmd",
            "symfony check:security": "script",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "chmod -R ug+w $APP_DIR/var"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false
        }
    }
}
